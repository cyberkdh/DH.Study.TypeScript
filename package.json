{
  "name": "dh-study-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript study lessons, building a developer calculator (DevCalc)",
  "license": "MIT",
  "author": "CYBERKDH",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node tools/check-pairs.ts && node tools/check-names.ts && vitest run",
    "test:watch": "vitest",
    "names": "node tools/check-names.ts",
    "pairs": "node tools/check-pairs.ts",
    "devcalc": "node devcalc/src/main.ts",
    "js": "node tools/show-js.ts",
    "build:web": "node tools/build-web.ts",
    "build:single": "node tools/build-single.ts",
    "web": "node --disable-warning=ExperimentalWarning tools/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
