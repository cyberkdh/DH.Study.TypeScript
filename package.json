{
  "name": "dh-study-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript 공부 기록 (DH.Study.TypeScript)",
  "license": "MIT",
  "author": "CYBERKDH",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"devcalc/tests/**/*.test.ts\"",
    "devcalc": "node devcalc/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
