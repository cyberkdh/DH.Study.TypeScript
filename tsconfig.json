{
  "compilerOptions": {
    // Language / module
    "target": "es2024",
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // .ts extensions in import paths → works with both direct node runs and tsc builds
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    // Allow only syntax that runs in node once types are erased (no enum / namespace / parameter properties)
    "erasableSyntaxOnly": true,

    // Strict mode
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Lint-like checks (lesson 09) : unused variables, imports and parameters are errors
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Output / debugging
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
