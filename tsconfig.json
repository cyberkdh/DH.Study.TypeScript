{
  "compilerOptions": {
    // Language / module
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Use .ts extensions in imports → works with both plain node and the tsc build
    // .ts extensions in import paths → works with both direct node runs and tsc builds
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    // Only syntax that node can run by erasing types (no enum / namespace / parameter properties)
    // Allow only syntax that runs in node once types are erased (no enum / namespace / parameter properties)
    "erasableSyntaxOnly": true,

    // Strict mode
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Output / debugging
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
