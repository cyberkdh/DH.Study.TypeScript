{
  "compilerOptions": {
    // Language / module (언어 / 모듈)
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Use .ts extensions in imports → works with both plain node and the tsc build
    // import 경로에 .ts 확장자 사용 → node 직접 실행과 tsc 빌드 모두 동작
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    // Only syntax that node can run by erasing types (no enum / namespace / parameter properties)
    // 타입만 지우면 node 로 실행되는 문법만 허용 (enum / namespace / 파라미터 프로퍼티 금지)
    "erasableSyntaxOnly": true,

    // Strict mode (엄격 모드)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Output / debugging (출력 / 디버깅)
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
