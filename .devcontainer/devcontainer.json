{
	// GitHub Codespaces / Dev Containers: run the lesson examples in the browser, no install
	// Run the lesson examples in the browser with nothing to install
	"name": "DH.Study.TypeScript",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "24" }
	},
	"postCreateCommand": "npm ci",
	"customizations": {
		"vscode": {
			"extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "yoavbls.pretty-ts-errors"]
		}
	}
}
